# Plugboard Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# =============================================================================
# Phoenix Server (Required)
# =============================================================================

# Generate with: mix phx.gen.secret
# Must be at least 64 characters for secure JWT signing
SECRET_KEY_BASE=GENERATE_A_SECRET_WITH_mix_phx.gen.secret

# Set to true in production to start the web server
PHX_SERVER=true

# Server port and host
PHX_PORT=4000
PHX_HOST=localhost

# =============================================================================
# PostgreSQL Database (Required)
# =============================================================================

POSTGRES_USER=plugboard
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
POSTGRES_DB=plugboard
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Connection pool settings
DB_POOL_SIZE=10
DB_QUERY_TIMEOUT=15000
DB_CONNECT_TIMEOUT=5000

# Enable IPv6 for database connections
ECTO_IPV6=false

# =============================================================================
# Security - Session & LiveView (Required in Production)
# =============================================================================

# Generate with: mix phx.gen.secret 32
SESSION_SIGNING_SALT=GENERATE_A_SALT_WITH_mix_phx.gen.secret_32
LIVE_VIEW_SIGNING_SALT=GENERATE_A_SALT_WITH_mix_phx.gen.secret_32

# Optional: Additional session encryption (recommended for production)
# SESSION_ENCRYPTION_SALT=GENERATE_A_SALT_WITH_mix_phx.gen.secret_32

# =============================================================================
# Application Settings (Optional - defaults shown)
# =============================================================================

# Maximum request body size in bytes (default: 10MB)
MAX_REQUEST_BODY_SIZE=10485760

# How often to reconcile mount points with database (ms)
MOUNT_STORE_RECONCILE_INTERVAL=300000

# How often to reconcile hooks with database (ms)
HOOK_STORE_RECONCILE_INTERVAL=300000

# =============================================================================
# Telephone Configuration (Optional - defaults shown)
# =============================================================================

# Token validity duration in seconds (default: 1 hour)
TELEPHONE_TOKEN_EXPIRY=3600

# How often clients should refresh tokens in seconds (default: 30 min)
TELEPHONE_TOKEN_REFRESH_INTERVAL=1800

# Heartbeat timeout before disconnect in ms (default: 60 sec)
TELEPHONE_HEARTBEAT_TIMEOUT_MS=60000

# =============================================================================
# WebSocket Proxy Configuration (Optional - defaults shown)
# =============================================================================

# Enable/disable WebSocket proxying
WEBSOCKET_PROXY_ENABLED=true

# Backend WebSocket connect timeout (ms)
WEBSOCKET_CONNECT_TIMEOUT_MS=5000

# Maximum WebSocket frame size (bytes)
WEBSOCKET_MAX_FRAME_SIZE=1048576

# WebSocket idle timeout before closing (ms)
WEBSOCKET_IDLE_TIMEOUT_MS=300000

# =============================================================================
# Rate Limiting Configuration (Optional - defaults shown)
# =============================================================================

# Auth endpoints (login, registration)
RATE_LIMIT_AUTH_LIMIT=5
RATE_LIMIT_AUTH_WINDOW_MS=60000

# API endpoints (token management, etc.)
RATE_LIMIT_API_LIMIT=100
RATE_LIMIT_API_WINDOW_MS=60000

# Proxy endpoints (all /call/* routes)
RATE_LIMIT_PROXY_LIMIT=10000
RATE_LIMIT_PROXY_WINDOW_MS=60000

# =============================================================================
# Production Settings (Optional)
# =============================================================================

# Enable SSL for database connections (default: true in production)
# DATABASE_SSL=true

# Force HTTPS redirect (default: true in production)
# FORCE_SSL=true

# =============================================================================
# Clustering (Optional - for Kubernetes/distributed deployments)
# =============================================================================

# DNS query for cluster discovery (e.g., plugboard.default.svc.cluster.local)
# DNS_CLUSTER_QUERY=

# =============================================================================
# Testing
# =============================================================================

# Test partition for parallel test execution
MIX_TEST_PARTITION=
